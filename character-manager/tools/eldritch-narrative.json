    }
   ]
  },
  {
   "id": "shared-hallucination",
   "kindId": "place",
   "name": "The Shared Hallucination",
   "aliases": [
    "the liminal space",
    "the false Mistvale"
   ],
   "tags": [
    "between-events"
   ],
   "status": "canon",
   "summary": "Where the players are between Event 9 and Event 10: a protected pocket realm shaped like Mistvale, not Mistvale itself.",
   "body": "Agreed as the narrative bridge between events. Obeah's protection, granting the players time to coordinate before the finale. Staff are to tell players plainly that this is neither the real Mistvale nor the Crimson Vale, so nobody plans around a place they are not in.",
   "sources": [
    {
     "label": "Eldritch Retro and Plot Meeting — 2026-07-19",
     "locator": "Decisions"
    }
   ]
  },
  {
   "id": "chernabog",
   "kindId": "npc",
   "name": "Chernabog",
   "aliases": [
    "Cherabog"
   ],
   "tags": [],
   "status": "draft",
   "summary": "Trades auranium for storied items, provided the player submits the item's story.",
   "body": "Collects storied items so they are not lost to history, and so they are available for the next night war. The route by which more metal reaches players before the Rite.",
   "sources": [
    {
     "label": "Eldritch Retro and Plot Meeting — 2026-07-19",
     "locator": "Decisions"
    }
   ]
  },
  {
   "id": "auranium",
   "kindId": "artifact",
   "name": "Auranium",
   "aliases": [
    "uranium"
   ],
   "tags": [
    "material"
   ],
   "status": "draft",
   "summary": "The metal the ritual components and the cannon are made from, and the constraint the finale turns on.",
   "body": "Players spent much of the supply on armour, leaving none for the cannon. Ritual components are a sunk cost; what is left forces a choice between cannon ammunition and other items. Crafting converts one-to-one with iron.",
   "sources": [
    {
     "label": "Eldritch Retro and Plot Meeting — 2026-07-19",
     "locator": "Decisions"
    }
   ]
  },
  {
   "id": "eldritch-cannon",
   "kindId": "artifact",
   "name": "The Eldritch Cannon",
   "aliases": [
    "the godslaying cannon"
   ],
   "tags": [
    "asset"
   ],
   "status": "draft",
   "summary": "One only, governed by a lost art card, to be spent breaking a rule inside defined bounds.",
   "body": "Settled as a boon that offsets a deliberately unfair fight rather than as a plot device. Exactly one is produced, with no separate mechanics for NPC cannons; expensive ammunition is the limiting factor.",
   "sources": [
    {
     "label": "Eldritch Retro and Plot Meeting — 2026-07-19",
     "locator": "Decisions"
    }
   ]
  },
  {
   "id": "thread-dangling",
   "kindId": "thread",
   "name": "Close the dangling threads",
   "aliases": [],
   "tags": [
    "unresolved"
   ],
   "status": "draft",
   "summary": "Roughly fifteen open threads to resolve without building new modules for them.",
   "body": "The agreed shape of the finale: minimise new lore, close what is already open, and prune the ideas document to the most impactful points.",
   "sources": [
    {
     "label": "Eldritch Retro and Plot Meeting — 2026-07-19",
     "locator": "Decisions"
