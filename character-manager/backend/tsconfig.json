{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "lib": ["ES2020"],
    "outDir": "./dist",
    // The backend imports the shared schema and engine, so the compilation
    // root is the project root. Output lands at dist/backend/src and
    // dist/shared -- see the "main" and "start" entries in package.json.
    "rootDir": "..",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "moduleResolution": "node"
  },
  "include": ["src/**/*", "../shared/**/*"],
  "exclude": ["node_modules", "../shared/**/*.test.ts", "../frontend/**/*"]
}
