PORT=3000
NODE_ENV=development

# Google Drive source sync (optional). Create an OAuth 2.0 Client ID of
# type "Web application" in Google Cloud, with the authorized redirect URI
#   <your origin>/api/google/connect/callback
# and the drive.metadata.readonly scope on the consent screen. Without
# these the Sources feature reports itself unconfigured and stays out of
# the way.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# Dev only: pretend Google exists, with fixture folders. Never set in
# production; the code refuses it there anyway.
# GOOGLE_FAKE=1
