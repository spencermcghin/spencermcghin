{
  "name": "larp-character-manager",
  "version": "1.0.0",
  "description": "A modern web application for managing live roleplaying (LARP) characters",
  "private": true,
  "scripts": {
    "install:all": "cd backend && npm install && cd ../frontend && npm install",
    "dev:backend": "cd backend && npm run dev",
    "dev:frontend": "cd frontend && npm run dev",
    "build:backend": "cd backend && npm run build",
    "build:frontend": "cd frontend && npm run build",
    "build:all": "npm run build:backend && npm run build:frontend",
    "test:engine": "rm -rf .engine-build && ./backend/node_modules/.bin/tsc -p shared/tsconfig.json && node --test .engine-build/engine.test.js",
    "start": "cd backend && npm start"
  },
  "keywords": [
    "larp",
    "character",
    "roleplaying",
    "manager"
  ],
  "author": "",
  "license": "MIT",
  "engines": {
    "node": ">=20.19"
  }
}
